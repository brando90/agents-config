{
  "model": "fable",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/agents-config/scripts/auto-update-tools.sh",
            "timeout": 60,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/agents-config/scripts/agent_session_register.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/agents-config/scripts/refresh-agents-config.sh",
            "timeout": 20,
            "statusMessage": "Refreshing agents-config"
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "max"
    },
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "inputNeededNotifEnabled": true
}
