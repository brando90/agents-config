{
  "version": 1,
  "settings": {
    "defaultProvider": "vals-codex",
    "defaultModel": "gpt-6.1-sol",
    "defaultThinkingLevel": "medium",
    "modelThinkingLevels": {
      "vals-codex/gpt-6.1-sol": "medium"
    },
    "enableSkillCommands": true,
    "packages": [
      "${CONFIG_DIR}/claude-accounts",
      "${CONFIG_DIR}/codex-accounts"
    ],
    "extensions": [
      "${CONFIG_DIR}/extensions/config-sync.ts",
      "${CONFIG_DIR}/extensions/sponsor-routes.ts"
    ],
    "skills": [
      "${CONFIG_DIR}/skills"
    ],
    "prompts": [],
    "themes": []
  },
  "externalExtensions": [
    "herdr-agent-state.ts"
  ],
  "trackedFiles": [
    "extensions/config-sync.ts",
    "extensions/sponsor-routes.ts",
    "claude-accounts/index.ts",
    "claude-accounts/accounts.json",
    "claude-accounts/launch.py",
    "claude-accounts/install.py",
    "claude-accounts/patch_dependency.py",
    "claude-accounts/package.json",
    "claude-accounts/package-lock.json",
    "codex-accounts/index.ts",
    "codex-accounts/auth.mjs",
    "codex-accounts/catalog.mjs",
    "codex-accounts/refresh-models.mjs",
    "codex-accounts/package.json"
  ],
  "trackedDirectories": [
    "skills"
  ],
  "privateSkillsDirectory": "${CONFIG_DIR}/private-skills",
  "skillLinkRoots": [
    "${HOME}/.codex/skills",
    "${HOME}/.claude/skills",
    "${HOME}/.agents/skills"
  ]
}
