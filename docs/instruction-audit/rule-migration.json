  "clarifications": [
    {
      "rule": "hard-6",
      "old": "Push any uncommitted agents-config changes and run QA if changes were pulled from another agent.",
      "new": "Publish only your owned agents-config changes after verification; model review remains opt-in under Hard Rule 3."
    },
    {
      "rule": "trigger-7",
      "old": "a **Summary** section of 5\u201310 bullet points max (one line each)",
      "new": "a **Summary** section of at most 10 concise bullet points (fewer for small changes)"
    },
    {
      "rule": "guideline-21",
      "old": "Load them with `cat ~/keys/<file>.txt` and set as env vars.",
      "new": "Load them transiently into the authorized tool or environment without printing secret values."
    },
    {
      "rule": "trigger-29",
      "old": "run Mega QA, commit only relevant files",
      "new": "run only the review tier explicitly requested under Hard Rule 3, commit only relevant files"
    },
    {
      "rule": "trigger-46",
      "old": "light quality assurance (QA), merge to `main`",
      "new": "requested quality assurance (QA), merge to `main`"
    },
    {
      "rule": "trigger-46",
      "old": "the QA verdict block, the model identifiers",
      "new": "the QA verdict block when requested, the model identifiers"
    },
