// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "Cursor",
  // Cursor / Claude Desktop-like layout: files left, agent chat right
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "left",
      "auto_open": false
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "minimap": {
    "show": "never"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "show_edit_predictions": true,
  "wrap_guides": [
    80
  ],
  "soft_wrap": "editor_width",
  "agent_servers": {
    "grok-build": {
      "type": "registry"
    },
    "antigravity-acp": {
      "type": "registry"
    },
    "devin": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "Gruvbox Light",
    "dark": "One Dark",
  },
  // Second look (Settings profile selector): the same layout with the dark Gruvbox Dark Soft theme
  "profiles": {
    "Gruvbox Dark Soft": {
      "settings": {
        "theme": {
          "mode": "light",
          "light": "Gruvbox Dark Soft",
          "dark": "One Dark",
        },
      },
    },
  },
}
